# Azure OpenAI (used by the RAG chat API once ported from the legacy app)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Comma-separated browser origins allowed to call the API (CORS). Must include
# the Squarespace site that embeds the chat widget. Use "*" to allow any origin.
ALLOWED_ORIGINS=*

# Cloudflare Turnstile CAPTCHA secret (optional). When set, /api/chat requires a
# valid Turnstile token verified server-side. Leave empty to disable.
TURNSTILE_SECRET_KEY=

# PostgreSQL connection string used by the SSR backend to persist the CRM domain
# (users, cases, evidence, grants, messages, audit logs). For local development,
# stand up a container with `etc/dev-db.sh up` (uses wslc.exe) and use the URL
# below. In production, point this at your Azure Database for PostgreSQL server.
DATABASE_URL=postgres://mommysheart:localdev@127.0.0.1:5432/mommysheart

# Secret used to sign/verify session cookies. Use a long random value in production.
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# Emit the `Secure` flag on session cookies (set to "true" behind HTTPS/production).
COOKIE_SECURE=false

# Logging verbosity (tracing/env-filter syntax). Unset uses a developer-friendly
# default that shows API requests and database operations. Examples:
#   RUST_LOG=warn                     -> warnings + errors only
#   RUST_LOG=info                     -> app events + API requests (no SQL)
#   RUST_LOG=debug                    -> everything, including each SQL statement
#   RUST_LOG="info,sqlx::query=debug" -> API events plus SQL only
RUST_LOG=info
