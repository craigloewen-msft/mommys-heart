# Nuxt runtimeConfig maps NUXT_* env vars onto the keys in nuxt.config.ts.
# Copy to .env and fill in for local development.

# --- Azure OpenAI (used by the RAG chat API once ported from legacy/) ---
NUXT_AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
NUXT_AZURE_OPENAI_API_KEY=your-api-key-here
NUXT_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
NUXT_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
NUXT_AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Comma-separated browser origins allowed to call the API (CORS). Must include
# the Squarespace site that embeds the chat widget. Use "*" to allow any origin.
NUXT_ALLOWED_ORIGINS=*

# Cloudflare Turnstile CAPTCHA secret (optional). When set, /api/chat requires a
# valid Turnstile token verified server-side. Leave empty to disable.
NUXT_TURNSTILE_SECRET_KEY=
