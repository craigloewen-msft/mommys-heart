# Azure OpenAI (used by the RAG chat API once ported from the legacy app)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Communication Services (ACS) Email. 
#
#   ACS_EMAIL_ENDPOINT       the resource endpoint, e.g.
#                            https://your-resource.communication.azure.com
#   ACS_EMAIL_ACCESS_KEY     the resource's base64 access key (from the
#                            connection string's `accesskey=` component)
#   ACS_EMAIL_SENDER_ADDRESS a verified sender, e.g.
#                            DoNotReply@your-domain.azurecomm.net
ACS_EMAIL_ENDPOINT=
ACS_EMAIL_ACCESS_KEY=
ACS_EMAIL_SENDER_ADDRESS=

# Branding + links shared by every email template.
BRAND_NAME=Mommy's Heart
APP_URL=
SUPPORT_EMAIL=

# EMAIL_DRY_RUN — when true, case-activity notifications are NOT actually sent;
# the server logs what it *would* have sent instead. Keep this `true` for local
# development/testing so you don't email real users; set it to `false` (or leave
# it unset) in production to send for real.
#
# To preview how the emails *look* without any email service, database, or web
# server, render every template to standalone HTML files you can open in a
# browser:  `cargo run --features ssr -- preview-emails` (writes to
# target/email-preview/, open index.html).
# Truthy values: true, 1, yes, on (case-insensitive).
EMAIL_DRY_RUN=true

# Comma-separated browser origins allowed to call the API (CORS). Must include
# the Squarespace site that embeds the chat widget. Use "*" to allow any origin.
ALLOWED_ORIGINS=*

# Cloudflare Turnstile CAPTCHA secret (optional). When set, /api/chat requires a
# valid Turnstile token verified server-side. Leave empty to disable.
TURNSTILE_SECRET_KEY=

# PostgreSQL connection string used by the SSR backend to persist the CRM domain
# (users, cases, evidence, grants, messages, audit logs). For local development,
# stand up a container with `etc/dev.sh build` (uses wslc.exe) and use the URL
# below. In production, point this at your Azure Database for PostgreSQL server.
DATABASE_URL=postgres://mommysheart:localdev@127.0.0.1:5432/mommysheart

# Secret used to sign/verify session cookies. Use a long random value in production.
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# Emit the `Secure` flag on session cookies (set to "true" behind HTTPS/production).
COOKIE_SECURE=false

# ── Evidence file storage (Azure Blob Storage) ──────────────────────────────
# Case evidence *files* are stored in a private Blob Storage container; the
# database keeps only metadata + a pointer. Two auth modes are supported:
#
# Local development (Azurite emulator). Stand up the emulator with
# `etc/dev.sh build` (uses wslc.exe) and set the well-known dev connection
# string below. This is the ONLY variable needed locally. The account key is
# Azurite's public, well-known key — it is not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
#
# Production (managed identity). Leave the connection string empty and instead
# set the account blob endpoint below; the app authenticates as its managed
# identity (grant it the "Storage Blob Data Contributor" role). No secrets.
# AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
#
# Container name for evidence blobs (created on startup if absent).
AZURE_STORAGE_CONTAINER=evidence

# Logging verbosity (tracing/env-filter syntax). Unset uses a developer-friendly
# default that shows API requests and database operations. Examples:
#   RUST_LOG=warn                     -> warnings + errors only
#   RUST_LOG=info                     -> app events + API requests (no SQL)
#   RUST_LOG=debug                    -> everything, including each SQL statement
#   RUST_LOG="info,sqlx::query=debug" -> API events plus SQL only
RUST_LOG=info
