# Azure OpenAI Configuration
# Create these resources in the Azure Portal:
#   1. An Azure OpenAI resource
#   2. Deploy a chat model (e.g. gpt-4o) and note the deployment name
#   3. Deploy an embedding model (e.g. text-embedding-ada-002) and note the deployment name

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Comma-separated list of browser origins allowed to call the API (CORS).
# This must include the site that embeds the chat widget, e.g.:
#   ALLOWED_ORIGINS=https://www.yourclient.com,https://yourclient.squarespace.com
# Use "*" to allow any origin (fine for a quick PoC, tighten for production).
ALLOWED_ORIGINS=*
