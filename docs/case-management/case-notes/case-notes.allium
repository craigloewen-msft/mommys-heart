-- allium: 3
-- case-notes.allium
--
-- Case-management MVP Case Notes lifecycle and invariants.
-- Requirement traceability: REQ-CN-001 through REQ-CN-011,
-- REQ-AUD-001 through REQ-AUD-004.

------------------------------------------------------------
-- Actors
------------------------------------------------------------

actor StaffUser {
    identified_by: Session
    user_id: String
    role: AccountRole
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum AccountRole {
    volunteer
    | operations_admin
    | site_admin
}

enum NoteState {
    draft
    | finalized
    | discarded
    | legacy
}

enum NoteAudience {
    internal_only
    | shared_legacy
}

enum UrgencyLevel {
    routine
    | elevated
    | urgent
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity CaseNote {
    note_id: String
    case_id: String
    author_user_id: String
    state: NoteState
    audience: NoteAudience
    activity_date: String
    urgency: UrgencyLevel
    finalization_signature_name: String
    finalization_signed_at: String
    immutable_when_final: Boolean

    transitions state {
        draft -> finalized
        draft -> discarded
        terminal: finalized
        terminal: discarded
        terminal: legacy
    }
}

entity CaseNoteAddendum {
    addendum_id: String
    parent_note_id: String
    author_user_id: String
    inherited_audience: NoteAudience
    immutable: Boolean
    signed_at: String
}

entity RestrictedAuditRecord {
    record_id: String
    entity_kind: String
    entity_id: String
    content_free: Boolean
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant FinalizedAndLegacyStayImmutable {
    for n in CaseNote:
        (n.state = finalized or n.state = legacy) implies n.immutable_when_final = true
}

invariant UrgencyUsesApprovedLevels {
    for n in CaseNote:
        n.urgency = routine or n.urgency = elevated or n.urgency = urgent
}

invariant AddendaStayImmutable {
    for a in CaseNoteAddendum:
        a.immutable = true
}

invariant AuditRecordsStayContentFree {
    for a in RestrictedAuditRecord:
        a.content_free = true
}

invariant LegacyAudiencePreserved {
    for n in CaseNote:
        n.state = legacy implies n.audience = shared_legacy
}

invariant AddendaInheritAudience {
    for a in CaseNoteAddendum:
        a.inherited_audience = note_of(a.parent_note_id).audience
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SaveDraft {
    when: UserSavesDraft(user_id, note_id)

    let n = note_of(note_id)

    requires: author_may_edit_draft(user_id, note_id)
    requires: n.state = draft

    ensures: DraftPersisted(note_id)
    ensures: RestrictedAuditCommitted(note_id)
}

rule DiscardDraft {
    when: UserDiscardsDraft(user_id, note_id)

    let n = note_of(note_id)

    requires: author_may_edit_draft(user_id, note_id)
    requires: n.state = draft

    ensures: n.state = discarded
    ensures: TombstonePreserved(note_id)
    ensures: RestrictedAuditCommitted(note_id)
}

rule FinalizeDraft {
    when: UserFinalizesDraft(user_id, note_id, typed_name)

    let n = note_of(note_id)

    requires: author_may_edit_draft(user_id, note_id)
    requires: n.state = draft
    requires: draft_passes_required_validation(note_id)
    requires: typed_name_matches_authenticated_user(user_id, typed_name)

    ensures: n.state = finalized
    ensures: n.finalization_signature_name = typed_name
    ensures: ServerFinalizationTimeSet(note_id)
    ensures: RestrictedAuditCommitted(note_id)
}

rule AddSignedAddendum {
    when: UserAddsAddendum(user_id, note_id)

    let n = note_of(note_id)

    requires: user_may_add_note(user_id, n.case_id)
    requires: n.state = finalized or n.state = legacy

    ensures: AddendumPersisted(note_id)
    ensures: RestrictedAuditCommitted(note_id)
}

rule ListCaseNotes {
    when: UserListsCaseNotes(user_id, case_id, filters)

    requires: user_may_view_case_notes(user_id, case_id)

    ensures: PaginatedFilteredNotesReturned(case_id, filters)
}

rule AdministrativeDraftInspection {
    when: AdminInspectsDraft(user_id, note_id)

    let n = note_of(note_id)

    requires: admin_may_inspect_draft(user_id, note_id)
    requires: n.state = draft

    ensures: DraftInspectionReturned(note_id)
    ensures: RestrictedAuditCommitted(note_id)
}

------------------------------------------------------------
-- Surface
------------------------------------------------------------

surface CaseNotesSurface {
    facing: StaffUser

    exposes:
        CaseNote.state
        CaseNote.audience

    provides:
        UserSavesDraft(user_id, note_id)
        UserDiscardsDraft(user_id, note_id)
        UserFinalizesDraft(user_id, note_id, typed_name)
        UserAddsAddendum(user_id, note_id)
        UserListsCaseNotes(user_id, case_id, filters)
        AdminInspectsDraft(user_id, note_id)

    @guarantee DraftIsolation
        -- Drafts remain hidden from ordinary non-author staff until
        -- finalization. Clients never receive structured note content or
        -- metadata showing that internal notes exist.

    @guarantee ImmutableOfficialRecord
        -- Finalized notes, legacy notes, and addenda do not become editable or
        -- deletable through the application. Corrections are appended rather
        -- than merged into the parent note.

    @guarantee HonestSafetyBoundary
        -- Recording elevated urgency in a note does not itself dispatch an alert
        -- or contact emergency services. Any future escalation workflow needs a
        -- separate policy-backed design.
}

------------------------------------------------------------
-- Deferred
------------------------------------------------------------

deferred SupervisorReviewWorkflow    -- see: docs/case-management/future-features/01-supervisor-review-and-safety-escalation.md
    -- Review/return/approval states are explicitly outside the MVP.

deferred FullNineteenSectionDynamicForm    -- see: docs/case-management/roadmap.md
    -- The MVP uses a bounded structured form instead of the client's full
    -- nineteen-section dynamic questionnaire.

deferred GlobalCrossCaseSearch    -- see: docs/case-management/future-features/05-time-units-funding-reporting-and-global-search.md
    -- Search remains limited to the authorized selected case in the MVP.
