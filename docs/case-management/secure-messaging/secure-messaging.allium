-- allium: 3
-- secure-messaging.allium
--
-- Case-management MVP secure messaging lifecycle and invariants.
-- Requirement traceability: REQ-MSG-001 through REQ-MSG-009,
-- REQ-AUD-001 through REQ-AUD-004.

------------------------------------------------------------
-- Actors
------------------------------------------------------------

actor User {
    identified_by: Session
    user_id: String
    role: AccountRole
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum AccountRole {
    client
    | volunteer
    | operations_admin
    | site_admin
}

enum Audience {
    shared
    | volunteer_only
}

enum ChannelState {
    active
    | archived
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity CaseChannel {
    channel_id: String
    case_id: String
    audience: Audience
    state: ChannelState
    is_permanent: Boolean

    transitions state {
        active -> archived
        terminal: archived
    }
}

entity Message {
    message_id: String
    channel_id: String
    case_id: String
    audience: Audience
    author_user_id: String
    body: String
    sent_at: String
    immutable: Boolean
}

entity FirstReadReceipt {
    message_id: String
    reader_user_id: String
    first_read_at: String
    write_once: Boolean
}

entity RestrictedAuditRecord {
    record_id: String
    entity_kind: String
    entity_id: String
    visibility: Audience
    content_free: Boolean
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant VolunteerOnlyIsolation {
    for c in CaseChannel:
        c.audience = volunteer_only implies c.is_permanent = true and c.state = active
}

invariant MessagesStayImmutable {
    for m in Message:
        m.immutable = true
}

invariant ReceiptsAreWriteOnce {
    for r in FirstReadReceipt:
        r.write_once = true
}

invariant AuditRecordsStayContentFree {
    for a in RestrictedAuditRecord:
        a.content_free = true
}

invariant ClientMetadataIsolation {
    for c in CaseChannel:
        c.audience = volunteer_only implies not client_can_observe_channel_metadata(c.channel_id)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SendMessage {
    when: UserRequestsMessageSend(user_id, channel_id, body)

    let c = channel_of(channel_id)

    requires: viewer_has_channel_access(user_id, channel_id)
    requires: sender_has_message_capability(user_id, c.case_id)
    requires: c.state = active
    requires: trim(body) != ""
    requires: len(trim(body)) <= configured_message_length_limit()
    requires: within_send_throttle(user_id, c.case_id)

    ensures: MessageAccepted(channel_id)
    ensures: MessageCommitted(channel_id)
    ensures: RecipientRowsCommitted(channel_id)
    ensures: RestrictedAuditCommitted(channel_id)
    ensures: NotificationQueuedAfterCommit(channel_id)
}

rule ArchiveStandardChannel {
    when: UserRequestsChannelArchive(user_id, channel_id)

    let c = channel_of(channel_id)

    requires: manager_may_archive(user_id, c.case_id)
    requires: c.state = active
    requires: c.audience = shared
    requires: not c.is_permanent
    requires: another_active_shared_channel_exists(c.case_id, channel_id)

    ensures: c.state = archived
    ensures: RestrictedAuditCommitted(channel_id)
}

rule ReadTranscriptCreatesFirstRead {
    when: UserRequestsTranscript(user_id, channel_id)

    let c = channel_of(channel_id)

    requires: viewer_has_channel_access(user_id, channel_id)

    ensures: TranscriptReturned(channel_id)
    ensures: MissingFirstReadReceiptsCreated(user_id, channel_id)
}

rule MarkServedMessagesRead {
    when: UserMarksServedMessagesRead(user_id, channel_id)

    requires: viewer_has_channel_access(user_id, channel_id)

    ensures: UnreadRowsClearedForServedMessages(user_id, channel_id)
}

rule ArchivedChannelRejectsSend {
    when: UserRequestsMessageSend(user_id, channel_id, body)

    let c = channel_of(channel_id)

    requires: c.state = archived

    ensures: MessageRejected(channel_id)
}

rule ExportTranscript {
    when: UserRequestsTranscriptExport(user_id, channel_id)

    let c = channel_of(channel_id)

    requires: viewer_has_channel_access(user_id, channel_id)
    requires: exporter_is_operations_or_site_admin(user_id)
    requires: exporter_has_view_case(user_id, c.case_id)

    ensures: CsvTranscriptReturned(channel_id)
    ensures: RestrictedAuditCommitted(channel_id)
}

------------------------------------------------------------
-- Surface
------------------------------------------------------------

surface SecureMessagingSurface {
    facing: User

    exposes:
        CaseChannel.state
        CaseChannel.audience

    provides:
        UserRequestsMessageSend(user_id, channel_id, body)
        UserRequestsTranscript(user_id, channel_id)
        UserMarksServedMessagesRead(user_id, channel_id)
        UserRequestsTranscriptExport(user_id, channel_id)
        UserRequestsChannelArchive(user_id, channel_id)

    @guarantee AudienceIsolation
        -- Every read, send, count, and export path uses the same server-side
        -- audience rules. Client accounts never observe volunteer-only channel
        -- existence through transcript data, counts, or export behavior.

    @guarantee ImmutableRecord
        -- Sent messages never become editable or deletable through the
        -- application. Archival changes channel state, not message content.

    @guarantee AtomicOfficialSend
        -- The official send record is accepted only when message persistence,
        -- recipient/read state, and restricted audit metadata all commit
        -- together. Email notification work happens only after commit.
}

------------------------------------------------------------
-- Deferred
------------------------------------------------------------

deferred MessageAttachments    -- see: docs/case-management/future-features/04-attachments-pdf-and-stronger-signatures.md
    -- File attachments are explicitly outside the MVP.

deferred EmailReplyIngestion    -- see: docs/case-management/roadmap.md
    -- External reply-to-email ingestion is explicitly outside the MVP.

deferred EndToEndEncryption    -- see: docs/case-management/secure-messaging/requirements.md
    -- The MVP does not claim or model E2EE.
