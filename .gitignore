# Rust / cargo-leptos
/target
/dist

# Env
.env
# Generated per checkout by etc/dev.sh — points this instance at its own
# database, blob container and web port.
.env.local

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
# Agent worktrees live here. The pattern MUST stay anchored with a leading '/':
# an unanchored '.phoenix' matches at every depth, so a checkout located *inside*
# .phoenix/worktrees/ would have its own source files treated as ignored — which
# silently blinds `cargo leptos watch` (it builds its watch list from .gitignore).
/.phoenix
