# Rust / cargo-leptos
/target
/dist
# Nested crates (archive/) build into their own target/; the anchored rule above
# does not cover those.
target/

# Env
.env

# Agent worktrees live under .kingdom/, but the service manifest beside them is
# the project's own and is committed: it declares the shared database and blob
# storage Kingdom raises for every agent working here.
/.kingdom/*
!/.kingdom/services.toml

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
# Agent worktrees live here. Keep this anchored: an unanchored '.phoenix' also
# matches the parent directory of every source file in an agent worktree.
/.phoenix

# Subscriber/contact exports. These carry names, emails, phone numbers and home
# addresses for real people and must never be committed.
*.csv
